# ================================================================
# RECLAIM OS — Backend Environment Configuration Example
# ================================================================
# Copy this file to backend/.env and replace placeholder values.
# NEVER commit real credentials, API secrets, or private keys to git.

# MongoDB connection configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=reclaim_os

# Authentication & Access Control
# Email address that automatically receives the 'owner' role on first OAuth login
OWNER_EMAIL=owner@example.com

# Webhook Secrets
# Server-side HMAC secret for generic merchant webhooks (POST /api/webhooks/payments)
WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Cron authentication bearer secret for platform scheduled sweeps (POST /api/cron/verification-sweep)
WEBHOOK_CRON_SECRET=your_platform_cron_secret_here

# AI / Intelligence Layer
# Universal API key for Claude Sonnet (claude-sonnet-4-6) analysis
EMERGENT_LLM_KEY=your_emergent_llm_api_key_here

# Internal & Public Networking
# Internal base URL for webhook forwarding and test lab callbacks
INTERNAL_WEBHOOK_BASE_URL=http://localhost:8001

# Public URL used to generate customer-facing payment recovery retry links
PUBLIC_APP_URL=http://localhost:3000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001
